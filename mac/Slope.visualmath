{
  "version": 1,
  "topic": "How do you read the slope of a line?",
  "source": "from manim import *\n\nclass GeneratedLesson(Scene):\n    def construct(self):\n        axes = Axes(x_range=[0, 5, 1], y_range=[0, 8, 1], x_length=6, y_length=4, tips=False)\n        start = axes.c2p(1, 2)\n        corner = axes.c2p(3, 2)\n        end = axes.c2p(3, 6)\n        title = Text('How steep is this line?', font_size=38).to_edge(UP)\n        self.play(Write(title), Create(axes), run_time=2)\n        self.play(Create(Line(axes.c2p(0, 0), axes.c2p(4, 8), color=BLUE)), run_time=2)\n        self.play(FadeIn(Dot(start)), FadeIn(Dot(end)))\n        self.wait(14)\n        run = Line(start, corner, color=YELLOW)\n        rise = Line(corner, end, color=GREEN)\n        caption = Text('Travel 2 units to the right.', font_size=30).to_edge(DOWN)\n        self.play(Create(run), Write(caption), run_time=2)\n        self.wait(17)\n        self.play(Create(rise), Transform(caption, Text('Then climb 4 units.', font_size=30).to_edge(DOWN)), run_time=2)\n        self.wait(17)\n        self.play(Transform(caption, Text('Slope = rise / run = 4 / 2 = 2', font_size=30).to_edge(DOWN)), run_time=2)\n        self.wait(20)\n        self.play(Transform(caption, Text('What if you move just 1 unit to the right?', font_size=30).to_edge(DOWN)), run_time=2)\n        self.wait(15)\n        self.play(Transform(run, Line(start, axes.c2p(2, 2), color=YELLOW)), Transform(rise, Line(axes.c2p(2, 2), axes.c2p(2, 4), color=GREEN)), Transform(caption, Text('You climb 2 units. The slope stays the same.', font_size=30).to_edge(DOWN)), run_time=2)\n        self.wait(22)\n"
}
